DATABASE_URL="file:./dev.db"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# JWT Authentication — generate with: openssl rand -base64 32
JWT_SECRET="your-strong-random-secret-here"

# Fast2SMS API Key — sign up at https://fast2sms.com (free tier available)
# Without this key, OTP will be logged to server console in development mode only
FAST2SMS_API_KEY="your-fast2sms-api-key-here"

# Maps (OpenStreetMap/Leaflet — no API key needed)
NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"
