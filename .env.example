DATABASE_URL="file:./dev.db"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# JWT Authentication — generate with: openssl rand -base64 32
JWT_SECRET="your-strong-random-secret-here"

# Fast2SMS API Key — sign up at https://fast2sms.com (free tier available)
# Without this key, OTP will be logged to server console in development mode only
FAST2SMS_API_KEY="your-fast2sms-api-key-here"

# Maps (OpenStreetMap/Leaflet — no API key needed)
NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"

# ─── OSINT & Real API Keys ────────────────────────────────────────────────────

# OpenWeatherMap — Free tier: 1,000 calls/day, 60 calls/min
# Sign up: https://openweathermap.org/api → Subscribe "Current Weather Data" (Free)
# Used for: Weather advisory on farmer booking page, Factor 6 in AI recommendation engine
OPENWEATHERMAP_API_KEY="your-openweathermap-api-key-here"

# Google Gemini AI — Free tier: 15 RPM / 1 million tokens/day
# Get key: https://aistudio.google.com/app/apikey (instant, no billing required)
# Used for: AI-powered "Why we recommend this centre" natural language explanations
GEMINI_API_KEY="your-gemini-api-key-here"

# data.gov.in OGD Platform India — Free, public datasets
# Register: https://data.gov.in/user/register (optional, default key works for public data)
# Used for: Real CACP MSP rates (Wheat/Paddy/Maize/Soybean) + Agmarknet daily mandi prices
DATA_GOV_IN_API_KEY="579b464db66ec23bdd000001cdd3946e44ce4aab825641fb7d15b68"

# Note: Geocoding uses OpenStreetMap Nominatim — completely free, no API key required.
# Note: Map tiles use OpenStreetMap — completely free, no API key required.
